{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LCOS",
  "version": "1.1.0",
  "identifier": "org.lcos.caisse",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principale",
        "title": "LCOS - Logiciel de caisse",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 vitiluxx - GPL-3.0-or-later",
    "category": "Business",
    "shortDescription": "Logiciel de caisse open source",
    "longDescription": "LCOS : logiciel de caisse open source, autonome et entierement local.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
